# ── SteelSoft API credentials ─────────────────────────────────────────────────
# Defaults are already baked into the code; only set these to override.
STEELSOFT_USER=
STEELSOFT_PASS=

# ── Vercel Cron secret ─────────────────────────────────────────────────────────
# Vercel generates this automatically when you enable cron jobs.
# For manual testing: set any random string here and pass it as:
#   curl -H "Authorization: Bearer <value>" http://localhost:3000/api/sync
CRON_SECRET=your-random-secret-here

# ── Vercel KV (production storage) ────────────────────────────────────────────
# Set up once in the Vercel dashboard:
#   Dashboard → Storage → Create → KV → Connect to project
# Then run: vercel env pull .env.local
# These vars are set automatically by Vercel after connecting.
KV_REST_API_URL=
KV_REST_API_TOKEN=
